{
  "name": "be-happi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Be Happi : horaires, locaux et déplacements de cours de l'IPES Tubize, dans Teams et sur téléphone.",
  "scripts": {
