    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-browser": "4.30.0",
    "@microsoft/teams-js": "2.58.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.4"
  }
}
